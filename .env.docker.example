# Environment variables for Docker
# Copy file này thành .env.docker và chỉnh sửa giá trị phù hợp

#==============================================
# Application Settings
#==============================================
PORT=8089

#==============================================
# Kafka Connection Settings
#==============================================
# Nếu Kafka chạy trong Docker network khác, dùng tên service/container
# Ví dụ: kafka:29092 hoặc kafka:9092

# Nếu Kafka chạy trên host machine (localhost)
# KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092

# Nếu Kafka chạy trong cùng Docker network
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Nếu Kafka chạy trên server khác
# KAFKA_BOOTSTRAP_SERVERS=192.168.1.100:9092

#==============================================
# Kafka Producer Settings
#==============================================
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=10
KAFKA_PRODUCER_MAX_IN_FLIGHT_REQUESTS=5
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_TOPIC=transaction_response

#==============================================
# Kafka Consumer Settings
#==============================================
KAFKA_CONSUMER_GROUP_ID=transaction_forwarder_group
KAFKA_CONSUMER_TOPIC=transaction_request
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false
KAFKA_CONSUMER_AUTO_OFFSET_RESET=latest
KAFKA_CONSUMER_SESSION_TIMEOUT=60000
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=20000
KAFKA_CONSUMER_ISOLATION_LEVEL=read_committed
