# Server Configuration
PORT=8089

# Kafka Configuration
# For Docker internal network, use: kafka:29092
# For host machine Kafka, use: host.docker.internal:9092
# For external server, use: <IP>:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Kafka Producer Settings
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=10
KAFKA_PRODUCER_MAX_IN_FLIGHT_REQUESTS=5
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_TOPIC=transaction_response

# Kafka Consumer Settings
KAFKA_CONSUMER_GROUP_ID=transaction_forwarder_group
KAFKA_CONSUMER_TOPIC=transaction_request
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false
KAFKA_CONSUMER_AUTO_OFFSET_RESET=latest
KAFKA_CONSUMER_SESSION_TIMEOUT=60000
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=20000
KAFKA_CONSUMER_ISOLATION_LEVEL=read_committed

# PostgreSQL Configuration
# For Docker internal network, use: postgres
# For host machine PostgreSQL, use: host.docker.internal
# For external server, use: <IP>
DB_HOST=postgres
DB_PORT=5432
DB_NAME=payment_terminal
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Optional: Connection Pool Settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
